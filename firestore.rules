rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/bookmarks/{variantId} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      allow read, delete: if owner();
      allow create, update: if owner()
        && variantId.matches('^[a-z0-9-]{1,100}$')
        && request.resource.data.keys().hasOnly(['variantId', 'savedAt'])
        && request.resource.data.keys().hasAll(['variantId', 'savedAt'])
        && request.resource.data.variantId == variantId
        && request.resource.data.savedAt == request.time;
    }
  }
}
