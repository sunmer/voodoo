# Public Firebase web configuration, not service-account credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_GA_MEASUREMENT_ID=
# Direct Cloud Run HTTPS origin. Rendering may exceed Hosting's 60-second timeout.
VITE_SHARE_API_ORIGIN=
# Local development only. Production builds always ignore this switch.
VITE_FIREBASE_EMULATORS=false
